{
  "name": "docker-build-push-action",
  "version": "7.1.0",
  "description": "Docker Build & Push Action",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --outfile=dist/index.js --format=cjs --conditions=import",
    "lint": "eslint 'src/**.js' 'tests/**.js' --fix",
    "test": "eslint 'src/**.js' 'tests/**.js' && NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "npm run test -- --watchAll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/docker-build-push.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Docker",
    "GCR",
    "ECR",
    "Docker Hub"
  ],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/docker-build-push/issues"
  },
  "homepage": "https://github.com/step-security/docker-build-push#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@jest/globals": "^30.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "mockdate": "^3.0.5",
    "prettier": "^3.9.6"
  },
  "jest": {
    "transform": {}
  }
}
